# 生产部署域名：只填主机名，不含 https:// 和路径。先把 DNS 指向你的服务器。
LAGENT_DOMAIN=lagent.example.com

# 管理员确认可信的模型供应商 HTTPS 主机名，逗号分隔，不能填通配符或 URL。
# 默认开放 DeepSeek、Claude（Anthropic）、OpenAI 官方接口，不把用户 API Key 放在这里。
# 此配置覆盖默认列表；显式留空可关闭 AI，注册、登录与确定性分析仍可用。
LAGENT_MODEL_HOSTS=api.deepseek.com,api.anthropic.com,api.openai.com

# 持久API Key加密主密钥：32字节随机值的base64，独立于数据库备份，勿提交。
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 留空时持久凭据库不可用，原会话Key模式仍可使用。
LAGENT_CREDENTIAL_MASTER_KEY=

# 指挥台控制面（/api/work/*）。默认启用；设为 0 会关闭接口，前端将提示「指挥服务未启用」。
LAGENT_WORK_ENABLED=1

# 外部执行器总开关（Codex、Claude Code、ACP、浏览器、GitHub、窗口）。
# 关闭时即使 policy 允许也会拒绝；设为 1 后仍需要在执行器策略中逐项勾选。
LAGENT_ALLOW_EXTERNAL_EXECUTORS=0

# 并发队列（outbox）：设为 1 时，超过 maxConcurrent 的工单先入队并持久化，
# 等执行器空闲后自动启动；默认 0 保持旧的同步启动行为。
LAGENT_WORK_OUTBOX=0
# 完成后自动运行工单里的验收命令；设为 0 关闭。
LAGENT_AUTO_VERIFY=1
# 单个 CLI / ACP 步骤的空闲超时与最大回合数（按需调整）。
LAGENT_STEP_IDLE_MS=
LAGENT_CLI_MAX_TURNS=

# ACP 适配器命令覆盖，留空时按 PATH 查找 codex-acp / claude-agent-acp / dsh-acp。
# 本机安装：npm i -g @agentclientprotocol/claude-agent-acp
LAGENT_CODEX_ACP=
LAGENT_CLAUDE_ACP=
LAGENT_DSH_ACP=

# WorkBuddy 桌面端执行器：通过 Chromium 调试端口派发任务并读取回复。
# 未运行时执行器会自动拉起 WorkBuddy（设为 0 则只连接已开启端口的实例）。
LAGENT_WORKBUDDY_AUTOLAUNCH=1
LAGENT_WORKBUDDY_PORT=9222
# WorkBuddy.exe 的完整路径；留空时按常见安装目录与开始菜单快捷方式查找。
LAGENT_WORKBUDDY_EXE=
# 单个任务的等待上限（毫秒），默认 10 分钟。
LAGENT_WORKBUDDY_TIMEOUT_MS=600000

# 窗口 Agent 可操作的白名单进程（逗号分隔，进程名不区分大小写）。
# 默认 codex,ChatGPT,claude,WindowsTerminal,wt,opencode,DSH Desktop,DeepSeek Harness,DeepSeek
LAGENT_WINDOW_PROCESSES=

# 窗口 Agent 发送后等待/轮询新输出的最长时间（毫秒，默认 30000，上限 120000）。
LAGENT_WINDOW_WAIT_MS=

# Codex CLI / Claude Code 单次执行超时（毫秒，默认 3600000 = 60 分钟）。
# 项目内的复杂任务常需要半小时以上，默认值比早期版本放宽；单步可用 executorInput.timeoutMs 覆盖（60000-7200000）。
LAGENT_CLI_TIMEOUT_MS=


# ── 云端手机号验证（仅 npm run cloud / 容器部署；本地桌面版不加载）──
# 设为 1 后：注册必须手机号+验证码；存量账号需绑定手机号；
# 密码登录在新设备上需要短信验证码（可信设备 30 天）。
LAGENT_REQUIRE_PHONE=0
# 验证码 HMAC 密钥，至少 16 位。留空时随机生成：单实例可用，但重启后已发验证码失效；
# 多实例部署必须显式配置同一值。
LAGENT_PHONE_SECRET=
# 短信供应商：none（默认，发送接口返回 503）、mock（仅开发/测试）、http（自定义网关）、aliyun（阿里云短信）。
LAGENT_SMS_PROVIDER=none
# 生产环境默认禁止 mock；确需联调时显式设为 1。
LAGENT_SMS_ALLOW_MOCK=0
# http 供应商：POST JSON {phone,code,purpose,signName,templateId} 到此地址，2xx 视为成功。
LAGENT_SMS_HTTP_URL=
LAGENT_SMS_HTTP_TOKEN=
LAGENT_SMS_SIGN_NAME=
LAGENT_SMS_TEMPLATE_ID=
# aliyun 供应商：AccessKey 需要 dysms:SendSms 权限；模板变量固定为 ${code}。
LAGENT_SMS_ACCESS_KEY_ID=
LAGENT_SMS_ACCESS_KEY_SECRET=
LAGENT_SMS_REGION=cn-hangzhou
# 全站每日短信发送上限（防止短信轰炸/账单失控，默认 500）。
LAGENT_SMS_DAILY_BUDGET=500

# ── 定时本地加密备份（默认关闭；口令不会写入数据库）──
# 间隔小时数，>0 且配置口令后启用；建议 6 或 24。
LAGENT_BACKUP_INTERVAL_HOURS=0
# 备份目录，容器内建议 /app/data/backups。
LAGENT_BACKUP_DIR=
# 备份口令，8–200 字符；丢失后备份无法恢复，请单独保管。
LAGENT_BACKUP_PASSPHRASE=
# 保留最近 N 份（默认 14）。
LAGENT_BACKUP_KEEP=14

# ── P1 协作与自动化 ──
# 外部访问地址（无尾斜杠），用于 IM 审批链接；也可在通知渠道里单独配置。
LAGENT_PUBLIC_URL=
# 关闭例行任务定时调度（默认开启；Webhook/手动触发仍可用）。
LAGENT_WORK_ROUTINES=1
# 内置模型 Agent 的 MCP 客户端总开关；默认开启，设为 0 关闭。
LAGENT_MCP_CLIENT=1
# 是否读取项目内的 .mcp.json（可执行配置，默认关闭）。
LAGENT_MCP_PROJECT_CONFIG=0
# 实时窗口观察总开关；设为 0 关闭。间隔 800–5000 毫秒。
LAGENT_LIVE_VIEW=1
LAGENT_LIVE_INTERVAL_MS=1000
