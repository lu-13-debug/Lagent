{
  "name": "lagent",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Lagent",
  "description": "面向个人与小团队的多 Agent 指挥台",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "cloud": "node server/cloud-index.js",
    "cloud:dev": "node --watch server/cloud-index.js",
    "test": "node --test server/*.test.js server/eval/*.test.js desktop/*.test.cjs src/*.test.mjs",
    "lint:arch": "node scripts/check-architecture.mjs",
    "bench:dataset": "node scripts/bench-dataset.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir --win --x64 --publish never",
    "desktop:build": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:e2e": "playwright test",
    "mobile:build": "node scripts/build-mobile.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mastra/core": "^1.82.0",
    "@mastra/libsql": "^1.29.0",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "multer": "^2.0.2",
    "playwright": "^1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
